<plist version="1.0">
<dict>

    <!-- App Group – geteilt mit Widget Extension und CarPlay -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.de.tommwagner.fahrtkosten</string>
    </array>

    <!-- iCloud Key-Value Store -->
    <key>com.apple.developer.ubiquity-kvstore-identifier</key>
    <string>$(TeamIdentifierPrefix)de.tommwagner.fahrtkosten</string>

    <!-- CarPlay Driving Task Entitlement -->
    <key>com.apple.developer.carplay-driving-task</key>
    <true/>

</dict>
</plist>
