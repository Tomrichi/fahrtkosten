<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
   Fahrtkosten.entitlements
   Fahrtkosten

   Created by Thomas Wagner on 29.04.26.
